func add(a: int, b: int) -> int {
    return a + b;
}
func average(a: float, b: float) -> float {
    return (a + b) / 2;
}
func is_even(n: int) -> bool {
    return n % 2 == 0;
}
func greet(name: string) {
    print("Hello, " + name);
}
func factorial(n: int) -> int {
    if (n <= 1) {
        return 1;
    }
    return n * factorial(n - 1);
}
func fib(n: int) -> int {
    if (n < 2) {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}
print(add(10, 20));
print(add(add(1, 2), add(3, 4)));
print(average(3, 4));
print(is_even(10));
greet("Linen");
print(factorial(10));
print(fib(15));
