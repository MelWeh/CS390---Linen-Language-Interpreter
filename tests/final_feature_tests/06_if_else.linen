let score: int = 84;
if (score >= 50) {
    print("pass");
}
if (score >= 90) {
    print("A");
} else if (score >= 80) {
    print("B");
} else if (score >= 70) {
    print("C");
} else {
    print("F");
}
let x: int = 3;
if (x % 2 == 0) {
    print("even");
} else {
    if (x > 2) {
        print("odd and big");
    } else {
        print("odd and small");
    }
}
let zero: int = 0;
if (zero != 0 && 10 / zero > 1) {
    print("unreachable");
} else {
    print("safe");
}
